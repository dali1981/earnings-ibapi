# Environment Configuration Example
# Copy this to .env and fill in your actual values

# Application Environment
APP_ENV=dev
APP_LOG_LEVEL=INFO

# Sentry Configuration (for observability)
# Get these values from your Sentry project settings
APP_OBSERVABILITY__SENTRY_DSN=https://your-dsn@your-org.ingest.sentry.io/your-project-id
APP_OBSERVABILITY__SENTRY_ENVIRONMENT=dev
APP_OBSERVABILITY__SENTRY_RELEASE=1.0.0

# Sentry Performance Settings
APP_OBSERVABILITY__SENTRY_SAMPLE_RATE=1.0
APP_OBSERVABILITY__SENTRY_TRACES_SAMPLE_RATE=0.1
APP_OBSERVABILITY__SENTRY_PROFILES_SAMPLE_RATE=0.1

# Feature Flags
APP_OBSERVABILITY__ENABLE_ERROR_TRACKING=true
APP_OBSERVABILITY__ENABLE_PERFORMANCE_MONITORING=true
APP_OBSERVABILITY__ENABLE_DISTRIBUTED_TRACING=true
APP_OBSERVABILITY__ENABLE_CELERY_MONITORING=true
APP_OBSERVABILITY__ENABLE_CUSTOM_METRICS=true

# Alert Configuration
APP_OBSERVABILITY__ENABLE_ALERTS=true
APP_OBSERVABILITY__ALERT_EMAIL_RECIPIENTS=["admin@yourcompany.com"]

# Celery Configuration
APP_CELERY__BROKER_URL=amqp://localhost:5672/
APP_CELERY__RESULT_BACKEND=redis://localhost:6379/0

# IB API Configuration
APP_IB__HOST=127.0.0.1
APP_IB__PORT=4002

# Service Port Configuration
# Override default ports for microservices (optional)

APP_API__SERVICES__FRONTEND__PORT=9000

# APP_API__SERVICES__CALENDAR__PORT=9001
# APP_API__SERVICES__EQUITY__PORT=9002
# APP_API__SERVICES__OPTIONS__PORT=9003
# APP_API__SERVICES__CHAINS__PORT=9004
# APP_API__SERVICES__ORCHESTRATOR__PORT=9005
# APP_API__SERVICES__IB_API__PORT=9010
# APP_API__SERVICES__TRADING__PORT=9011

# Service Host/Protocol Configuration (optional)
# APP_API__SERVICES__CALENDAR__HOST=0.0.0.0
# APP_API__SERVICES__CALENDAR__PROTOCOL=http

# Production Safety
ALLOW_PROD_WRITES=0